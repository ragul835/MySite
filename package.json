{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "lint": "prettier --check \"artifacts/{agency-site,api-server}/**/*.{ts,tsx,mjs}\" \"lib/{db,api-zod}/**/*.ts\"",
    "format": "prettier --write \"artifacts/{agency-site,api-server}/**/*.{ts,tsx,mjs}\" \"lib/{db,api-zod}/**/*.ts\"",
    "start": "node --env-file=.env --enable-source-maps artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
