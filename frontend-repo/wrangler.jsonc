{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weraisetech-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "weraisetech.com", "custom_domain": true },
    { "pattern": "www.weraisetech.com", "custom_domain": true }
  ]
}
