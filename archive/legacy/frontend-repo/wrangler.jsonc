{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weraisetech-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "weraisetech.com", "custom_domain": true },
    { "pattern": "www.weraisetech.com", "custom_domain": true }
  ]
}
