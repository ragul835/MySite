# ==========================================
# Frontend Configuration
# ==========================================
# The public URL of the backend API (used by the frontend)
VITE_API_URL=https://api.yourdomain.com

# ==========================================
# Backend Configuration
# ==========================================
# The port the backend will run on
PORT=5001

# The URL of your deployed frontend (required for CORS configuration)
FRONTEND_URL=https://yourdomain.com

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
PGHOST=localhost
PGPORT=5432
PGDATABASE=agency_db
PGUSER=postgres
PGPASSWORD=your_secure_db_password
JPA_DDL_AUTO=update

# ==========================================
# Security Configuration
# ==========================================
# Must be a long, secure random string for signing JWT tokens in production
JWT_SECRET=your_super_secret_jwt_key_here
# JWT Expiration time in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ==========================================
# Mail Configuration (Zoho SMTP)
# ==========================================
MAIL_HOST=smtp.zoho.in
MAIL_PORT=587
MAIL_USERNAME=your_zoho_email@zohomail.in
MAIL_PASSWORD=your_zoho_app_password

# ==========================================
# Application Configuration
# ==========================================
ADMIN_EMAIL=your_admin_email@example.com
