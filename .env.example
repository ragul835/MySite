# Canonical production API configuration
NODE_ENV=production
PORT=5001
DATABASE_URL=postgresql://agency_user:replace_me@127.0.0.1:5432/agency_db
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
LOG_LEVEL=info

# Comma-separated when more than one frontend origin is allowed.
FRONTEND_URL=https://weraisetech.com
TRUST_PROXY_HOPS=1

# Keep empty when the frontend and API share an origin.
VITE_API_URL=

# Optional email notifications. When RESEND_API_KEY is set, both addresses are required.
RESEND_API_KEY=
ADMIN_EMAIL=weraisetech@gmail.com
CONTACT_FROM_EMAIL=We Raise Tech <contact@weraisetech.com>

# Apply checked-in Drizzle migrations before the server accepts traffic.
RUN_MIGRATIONS=true
DB_MIGRATIONS_DIR=lib/db/drizzle
STATIC_DIR=artifacts/agency-site/dist/public
